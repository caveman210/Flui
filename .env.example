# ==============================================================================
# Flui Desktop Shell Configuration
# Copy this file to .env and configure your preferences:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Weather Settings
# ------------------------------------------------------------------------------
# Provider options: openmeteo, wttr, metno, aggregator
FLUI_WEATHER_PROVIDER=aggregator
# Location: Optional city name or coordinates (e.g., "London" or "51.5074,0.1278"). Leave blank for auto IP.
FLUI_WEATHER_LOCATION=
# API Key: Optional (only needed for custom proprietary providers)
FLUI_WEATHER_API_KEY=
# Poll interval in minutes
FLUI_WEATHER_POLL_INTERVAL=5

# ------------------------------------------------------------------------------
# 2. Island & Bar Layout
# ------------------------------------------------------------------------------
# Layout mode: 0 = Pill (default), 1 = Notch, 2 = Bar
FLUI_LAYOUT=1
# Bar edge dock position: 0 = Top, 1 = Bottom (applies to Bar layout)
FLUI_BAR_EDGE_POSITION=1
# Display slot rotation in Bar / Pill: "cycle", "weather", "motivation"
FLUI_BAR_INFO_MODE=cycle
# Automatically hide bar/island on inactivity
FLUI_AUTOHIDE=false

# ------------------------------------------------------------------------------
# 3. Wallpaper & Shuffling
# ------------------------------------------------------------------------------
# Directory containing your desktop wallpapers
FLUI_WALLPAPER_DIR="$HOME/Pictures/Wallpapers"
# Initial / current wallpaper image path
FLUI_CURRENT_WALLPAPER="$HOME/Pictures/Wallpapers/cloudsnight.jpg"
# Enable automatic wallpaper shuffling
FLUI_WALLPAPER_SHUFFLE=true
# Shuffle frequency interval: 15m, 30m, 1h, 3h, 6h, 12h, 1d
FLUI_WALLPAPER_SHUFFLE_INTERVAL=15m
# awww transition effect: grow, fade, simple, wipe, wave, center, outer, random
FLUI_WALLPAPER_TRANSITION_TYPE=grow
# Transition animation duration in seconds
FLUI_WALLPAPER_TRANSITION_DURATION=2

# ------------------------------------------------------------------------------
# 4. Matugen Material Theming & App Permissions
# ------------------------------------------------------------------------------
# Master switch for Matugen dynamic color generation from wallpapers
FLUI_MATUGEN_ENABLED=true
# Comma-separated list of external apps Matugen is permitted to re-theme:
# Options: quickshell,kitty,gtk,cava,zen,nvim,yazi,hyprlock
FLUI_THEMED_APPS=quickshell,kitty,gtk,cava

# ------------------------------------------------------------------------------
# 5. Night Light Settings
# ------------------------------------------------------------------------------
FLUI_NIGHTLIGHT_SCHEDULE=true
FLUI_NIGHTLIGHT_START=20:00
FLUI_NIGHTLIGHT_END=07:00
FLUI_NIGHTLIGHT_TRANSITION_MINS=15
FLUI_NIGHTLIGHT_TARGET_TEMP=4500
FLUI_NIGHTLIGHT_CURVE=scurve

# ------------------------------------------------------------------------------
# 6. Notifications & State
# ------------------------------------------------------------------------------
# Do Not Disturb mode
FLUI_DND=false
# First run completed flag (set to true to skip initial onboarding window)
FLUI_FIRST_RUN_COMPLETED=true
